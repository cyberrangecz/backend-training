<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cz.cybersecurityhub.maven</groupId>
        <artifactId>training</artifactId>
        <version>${app-version}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>training-rest</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>cz.cybersecurityhub.maven</groupId>
            <artifactId>training-service</artifactId>
            <version>${app-version}</version>
        </dependency>
        <dependency>
            <groupId>cz.cybersecurityhub.maven</groupId>
            <artifactId>training-api</artifactId>
            <version>${app-version}</version>
        </dependency>
        <dependency>
            <groupId>cz.cybersecurityhub.maven</groupId>
            <artifactId>training-opensearch</artifactId>
            <version>${app-version}</version>
        </dependency>
        <dependency>
            <groupId>cz.cybersecurityhub.maven</groupId>
            <artifactId>training-persistence</artifactId>
            <version>${app-version}</version>
        </dependency>
        <dependency> <!-- reuse src/test/java code from persistence module! -->
            <groupId>cz.cybersecurityhub.maven</groupId>
            <artifactId>training-persistence</artifactId>
            <version>${app-version}</version>
            <scope>test</scope>
            <classifier>tests</classifier>
        </dependency>
        <!--SPRING BOOT STARTERS-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--COMPILE (DEFAULT SCOPE)-->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-ui</artifactId>
        </dependency>

        <!--TEST-->
        <dependency>
            <groupId>com.vmlens</groupId>
            <artifactId>concurrent-junit</artifactId>
            <version>${concurrent-junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- Spotless: auto-formatting check -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>

            <!-- Surefire: unit tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!-- Checkstyle: style & lint rules -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>

            <!-- SpotBugs -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>

            <!-- OWASP Dependency-Check -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!--Expose the project version to OpenApiConfiguration via BuildProperties-->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--Generate OpenAPI documentation into doc-files, activated by -Dswagger.skip=false.
            Runs only OpenApiDocsGeneratorTest, even when -DskipTests is given.-->
        <profile>
            <id>docs</id>
            <activation>
                <property>
                    <name>swagger.skip</name>
                    <value>false</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skipTests>false</skipTests>
                            <test>OpenApiDocsGeneratorTest</test>
                            <systemPropertyVariables>
                                <docs.output.directory>${project.basedir}/../doc-files</docs.output.directory>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
