<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <statusListener class="ch.qos.logback.core.status.OnErrorConsoleStatusListener"/>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <!-- Removes every stack frame beyond the 8th of a run from the message text. -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}} %5p ${PID:-} --- [%15.15t] %-40.40logger{39} : %replace(%m){'((?:\n.at [^\n]*){8})(?:\n.at [^\n]*)+', '$1'}%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <logger name="org.springframework" level="OFF"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
